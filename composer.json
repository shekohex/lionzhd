{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shekohex/lionz",
    "version": "1.0.13",
    "type": "project",
    "description": "lionz.tv Download Tool using aria2 and built with the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.26",
        "http-interop/http-factory-guzzle": "^1.2",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.17",
        "laravel/pulse": "^1.7",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.2",
        "laravel/telescope": "^5.20",
        "laravel/tinker": "^3.0",
        "meilisearch/meilisearch-php": "^1.13",
        "saloonphp/cache-plugin": "^3.0",
        "saloonphp/saloon": "^3.11",
        "sentry/sentry-laravel": "^4.25",
        "spatie/laravel-data": "dev-l13-support#1c17f1b59070e018070c0c24c47758fe557b112f",
        "spatie/laravel-typescript-transformer": "^3.2",
        "tightenco/ziggy": "^2.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "dev-main",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.62",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1",
        "rector/rector": "^2.0"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/driftingly/rector-laravel.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php -r \"mkdir('vendor/_ide_helper', recursive: true);\"",
            "@php artisan ide-helper:generate -W --ansi",
            "@php artisan ide-helper:models -M --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"sh -c 'php -d memory_limit=${SYNC_MEDIA_MEMORY_LIMIT:-512M} artisan queue:listen --tries=1 --timeout=0'\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite"
        ],
        "dev:ssr": [
            "bun run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"sh -c 'php -d memory_limit=${SYNC_MEDIA_MEMORY_LIMIT:-512M} artisan queue:listen --tries=1 --timeout=0'\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
        ],
        "test:browser": [
            "bun run test:browser:prepare",
            "./vendor/bin/pest tests/Browser"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
