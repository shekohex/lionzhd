includes:
    # Existing project baseline for legacy debt outside this API goal work.
    # Goal-touched paths are checked without adding new baseline suppressions.
    - phpstan-baseline.neon
    - phpstan-level8-baseline.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
parameters:
    level: 8
    noEnvCallsOutsideOfConfig: false
    checkOctaneCompatibility: true
    checkModelProperties: true
    treatPhpDocTypesAsCertain: false
    paths:
        - app
        - database
        - routes
        - database/factories
    scanFiles:
        - vendor/_ide_helper/models.php
